{
  "name": "backend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "render:build": "npm install && npm run build",
    "render:start": "npm start",
    "docker:up": "./scripts/start-db.sh",
    "docker:down": "./scripts/stop-db.sh",
    "docker:logs": "docker compose logs -f",
    "db:setup": "npx tsx src/scripts/setup-database.ts",
    "db:migrate": "npx tsx src/scripts/migrate-database.ts",
    "db:seed": "npx tsx src/scripts/seed-database.ts",
    "db:reset": "npx tsx src/scripts/reset-database.ts",
    "postbuild": "npx tsx src/scripts/setup-database.ts"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cloudinary": "^2.5.0",
    "clsx": "^2.1.1",
    "firebase": "^12.4.0",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^0.546.0",
    "next": "16.0.0",
    "next-themes": "^0.4.6",
    "nodemailer": "^6.9.15",
    "pg": "^8.12.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "stripe": "^17.0.0",
    "tailwind-merge": "^3.3.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^20",
    "@types/nodemailer": "^6.4.19",
    "@types/pg": "^8.11.10",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.0.0",
    "tailwindcss": "^4",
    "ts-node": "^10.9.2",
    "typescript": "^5"
  }
}
