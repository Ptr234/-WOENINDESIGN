rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Users can read and write their own user document
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Public designers and suppliers can be read by anyone
    match /designers/{designerId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == designerId;
    }
    
    match /suppliers/{supplierId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == supplierId;
    }
    
    // Messages - users can read/write messages in conversations they're part of
    match /conversations/{conversationId} {
      allow read, write: if request.auth != null 
        && request.auth.uid in resource.data.participants;
    }
    
    match /conversations/{conversationId}/messages/{messageId} {
      allow read, write: if request.auth != null;
    }
    
    // Portfolio items
    match /portfolio/{portfolioId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == resource.data.userId;
    }
    
    // Projects and hiring requests
    match /projects/{projectId} {
      allow read, write: if request.auth != null 
        && (request.auth.uid == resource.data.clientId 
            || request.auth.uid == resource.data.designerId);
    }
    
    // Admin only collections
    match /admin/{document=**} {
      allow read, write: if request.auth != null 
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
  }
}